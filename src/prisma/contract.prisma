// use prisma-8

model Post {
  id        Int    @id@default(autoincrement())
  title     String
  content   String
  authorId  Int
  author    User @relation(fields:[authorId], references: [id])
  category  String
}

model User{
  id    Int   @id@default(autoincrement())
  email   String  @unique
  hashPassword  String
  posts Post[]
}